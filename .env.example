# Copy to .env (never committed). All keys optional for ingestion of public repos.
GITHUB_TOKEN=
# openai | anthropic | fake   (fake = offline canned answers for tests)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
# Where the Playwright/Chromium rig is installed (outside the repo)
DEMOFORGE_RIG=%LOCALAPPDATA%/Temp/demoforge-rig
# Set to 1 to enable tests that hit the network
DEMOFORGE_LIVE=0
